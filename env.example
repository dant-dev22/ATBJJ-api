# Archivo de ejemplo de variables de entorno de la API.
# Copiar a .env y ajustar los valores. El .env real NUNCA se versiona.
# Refleja todas las variables que lee config.py.

# --- Servidor ---
# Puerto del servidor. Obligatoria (default 5000).
PORT=5000
# Torneo activo. Obligatoria (default 2026-b).
CURRENT_TOURNAMENT=2026-b

# --- Base de datos MySQL ---
# Obligatorias (defaults: localhost / 3306 / root / (vacío) / aztlan2026).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aztlan2026

# --- Comprobantes ---
# Carpeta donde se guardan los comprobantes subidos. Obligatoria (default uploads/comprobantes).
UPLOAD_FOLDER=uploads/comprobantes

# --- Email (Gmail SMTP) ---
# Remitente de Gmail. Opcional: si falta GMAIL_USER o GMAIL_APP_PASSWORD, no se envían correos (EMAIL_ENABLED=false).
GMAIL_USER=
# Contraseña de aplicación de Gmail (no la contraseña normal de la cuenta). Opcional (ver arriba).
GMAIL_APP_PASSWORD=
# Correo que recibe aviso cuando alguien sube un comprobante. Opcional.
ADMIN_EMAIL=

# --- Asistencias ---
# Catálogo de clases, formato "id|Nombre|Descripción", separadas por coma. Opcional (tiene default interno).
ATTENDANCE_CLASSES=fundamentos|Fundamentos|Tecnica base y repaso de movimientos,intermedios|Intermedios|Secuencias y detalle tecnico,avanzados|Avanzados|Trabajo tecnico de alta exigencia,open-mat|Open Mat|Rondas libres y repaso supervisado
